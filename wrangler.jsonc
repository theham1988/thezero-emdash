{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thezero-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-marketing-site","database_id": "b11c7332-31ee-41c1-9168-51bca2df8c23",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-marketing-media","preview_bucket_name": "my-marketing-media",
		},
	],
	// Lead gateway: audit log and duplicate-submit window (src/lead-gateway)
	"kv_namespaces": [
		{
			"binding": "LEADS",
			"id": "81e4b72b4fd04b0c87b155a7b606f9b2",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
