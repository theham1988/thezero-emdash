---
/**
 * Site layout in The Zero Phuket design. Header, footer, WhatsApp button and
 * mobile bar come straight from the approved page designs (src/design/),
 * with the shared tracking added. Every page of the site uses this layout.
 */
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import footerHtml from "../design/footer.html?raw";
import defaultHeader from "../design/header.html?raw";
import sharedScript from "../design/shared.js?raw";
import { trackingBody, trackingHead } from "../tracking";
import { resolveSiteIdentity } from "../utils/site";
import wpSeoData from "../data/wp-seo.json";
import "../design/styles.css";
import "../styles/zero-extra.css";
import "../styles/zero-premium.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Menu item to mark as current, by its href: "/media" or "/privileges". */
	active?: string;
	/** A page's own header markup (the home page has scroll-spy attributes). */
	headerHtml?: string;
	/** A page's own script. It replaces the shared one, so it must include the header behaviour. */
	pageScript?: string;
	/** Load reCAPTCHA Enterprise (pages with a lead form). */
	recaptcha?: boolean;
}

const { title, pageTitle, description, image, canonical, robots, content, active, headerHtml, pageScript, recaptcha } = Astro.props;

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settingsResult.data);

// Search tags carried over from the WordPress site, page by page (src/data/wp-seo.json).
// Where a page has an entry, its title, description, robots, geo tags and structured data win.
type WpSeo = { title: string; description: string; robots: string; meta: string[][]; ld: unknown[] };
const DEFAULT_ROBOTS = "index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large";
const withSlash = (u: string) => (/\/$|\.[a-z0-9]+$/i.test(u) ? u : `${u}/`);
const pathKey = withSlash(Astro.url.pathname);
const wp = (wpSeoData as Record<string, WpSeo>)[pathKey];
// WordPress wrote "Page - The Zero Phuket"; keep that form.
const fullTitle = wp?.title || (title ? (title.includes(siteTitle) ? title : `${title} - ${siteTitle}`) : siteTitle);
const metaDescription = wp ? wp.description : description || siteTagline || undefined;
const robotsValue = robots ?? wp?.robots ?? DEFAULT_ROBOTS;
const wpImage = wp?.meta.find((m) => m[1] === "og:image")?.[2];
const shareImage = wpImage ? wpImage.replace("https://thezerophuket.com", Astro.url.origin) : image;
// WordPress addresses end in a slash; that is the address Google has indexed.
const canonicalUrl = withSlash((canonical ?? `${Astro.url.origin}${Astro.url.pathname}`).split("?")[0]);
const extraMeta = (wp?.meta ?? []).filter((m) => m[1].startsWith("geo.") || m[1] === "ICBM" || m[1].startsWith("product:"));

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: wp?.title ?? pageTitle ?? title ?? siteTitle,
	description: metaDescription,
	canonical: canonicalUrl,
	image: shareImage,
	content,
	seo: { ogImage: shareImage, robots: robotsValue },
	siteName: siteTitle,
});

let header = headerHtml ?? defaultHeader;
if (!headerHtml && active) {
	header = header.replace(`<a href="${active}">`, `<a href="${active}" class="active" aria-current="page">`);
}
const FONTS = "https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@200;300;400;600&family=Dosis:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap";
const RECAPTCHA_KEY = "6Ldwts0sAAAAAJyCO0rUaBgYx5eiQM4voxaURbmV";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<Fragment set:html={trackingHead} />
		{extraMeta.map((m) => (m[0] === "property" ? <meta property={m[1]} content={m[2]} /> : <meta name={m[1]} content={m[2]} />))}
		<slot name="head" />
		<EmDashHead page={pageCtx} />
		{(wp?.ld ?? []).map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
		<link rel="icon" href="/wp-content/uploads/2025/09/logo_zero.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href={FONTS} /></noscript>
		{recaptcha && <script is:inline define:vars={{ RECAPTCHA_KEY }}>
			// reCAPTCHA loads on the visitor's first touch, scroll or key press, so it does not slow the first paint.
			// Forms wait on window.zpRecaptcha() before asking for a token.
			(() => {
				let p;
				window.zpRecaptcha = () => p || (p = new Promise((done) => {
					const s = document.createElement("script");
					s.src = "https://www.google.com/recaptcha/enterprise.js?render=" + RECAPTCHA_KEY;
					s.onload = () => (window.grecaptcha && grecaptcha.enterprise ? grecaptcha.enterprise.ready(done) : done());
					s.onerror = done;
					setTimeout(done, 5000);
					document.head.appendChild(s);
				}));
				const go = () => { window.zpRecaptcha(); ["pointerdown", "keydown", "scroll", "touchstart"].forEach((e) => removeEventListener(e, go)); };
				["pointerdown", "keydown", "scroll", "touchstart"].forEach((e) => addEventListener(e, go, { passive: true, once: true }));
			})();
		</script>}
		{recaptcha && <script is:inline src="/js/zp-phone.js" defer />}
	</head>
	<body>
		<Fragment set:html={trackingBody} />
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<Fragment set:html={header} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Fragment set:html={footerHtml} />
		<script is:inline set:html={pageScript ?? sharedScript} />
		<script is:inline>
			// Phone menu: the button opens the full list of pages; choosing a page or pressing Escape closes it.
			(() => {
				const nav = document.getElementById("nav"), btn = document.getElementById("menuToggle");
				if (!nav || !btn) return;
				const set = open => { nav.classList.toggle("open", open); btn.setAttribute("aria-expanded", open); document.documentElement.classList.toggle("menu-open", open); };
				btn.addEventListener("click", () => set(!nav.classList.contains("open")));
				document.getElementById("menus").addEventListener("click", e => { if (e.target.closest("a")) set(false); });
				document.addEventListener("keydown", e => { if (e.key === "Escape") set(false); });
			})();
		</script>
		<div id="google_translate_element" hidden></div>
		<script is:inline>
			// Google Translate is only needed once a visitor has picked another language.
			if (/googtrans=\/en\/(?!en)/.test(document.cookie)) {
				const t = document.createElement("script");
				t.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
				document.body.appendChild(t);
			}
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
