---
/**
 * Site layout in The Zero Phuket design. Header, footer, WhatsApp button and
 * mobile bar come straight from the approved page designs (src/design/),
 * with the shared tracking added. Every page of the site uses this layout.
 */
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import footerHtml from "../design/footer.html?raw";
import defaultHeader from "../design/header.html?raw";
import sharedScript from "../design/shared.js?raw";
import { trackingBody, trackingHead } from "../tracking";
import { resolveSiteIdentity } from "../utils/site";
import "../design/styles.css";
import "../styles/zero-extra.css";
import "../styles/zero-premium.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Menu item to mark as current, by its href: "/media" or "/privileges". */
	active?: string;
	/** A page's own header markup (the home page has scroll-spy attributes). */
	headerHtml?: string;
	/** A page's own script. It replaces the shared one, so it must include the header behaviour. */
	pageScript?: string;
	/** Load reCAPTCHA Enterprise (pages with a lead form). */
	recaptcha?: boolean;
}

const { title, pageTitle, description, image, canonical, robots, content, active, headerHtml, pageScript, recaptcha } = Astro.props;

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settingsResult.data);
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} ${titleSeparator} ${siteTitle}`) : siteTitle;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || undefined,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

let header = headerHtml ?? defaultHeader;
if (!headerHtml && active) {
	header = header.replace(`<a href="${active}">`, `<a href="${active}" class="active" aria-current="page">`);
}
const RECAPTCHA_KEY = "6Ldwts0sAAAAAJyCO0rUaBgYx5eiQM4voxaURbmV";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<Fragment set:html={trackingHead} />
		<EmDashHead page={pageCtx} />
		<link rel="icon" href="/wp-content/uploads/2025/09/logo_zero.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@200;300;400;600&family=Dosis:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		{recaptcha && <script is:inline src={`https://www.google.com/recaptcha/enterprise.js?render=${RECAPTCHA_KEY}`} async defer />}
	</head>
	<body>
		<Fragment set:html={trackingBody} />
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<Fragment set:html={header} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Fragment set:html={footerHtml} />
		<script is:inline set:html={pageScript ?? sharedScript} />
		<div id="google_translate_element" hidden></div>
		<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
