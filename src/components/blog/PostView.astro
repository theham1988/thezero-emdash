---
import { PortableText } from "emdash/ui";
import { formatDate, imageUrl, localizeContent } from "../../utils/media";
import PostImage from "./PostImage.astro";

interface Props {
	post: any;
}

const { post } = Astro.props;
const hero = imageUrl(post.data.featured_image);
const published = post.data.publishedAt ?? post.data.createdAt;
const content = localizeContent(post.data.content);
const category = post.data.terms?.category?.[0]?.label;
---

<article class="article">
	<header class="article-wrap article-head">
		{category && <span class="eyebrow">{category}</span>}
		<h1 {...post.edit.title}>{post.data.title}</h1>
		{published && <time class="article-date" datetime={new Date(published).toISOString()}>{formatDate(published)}</time>}
	</header>
	{
		hero && (
			<div class="article-figure" {...post.edit.featured_image}>
				<img src={hero} alt={post.data.featured_image?.alt ?? ""} decoding="async" fetchpriority="high" onerror="this.closest('.article-figure').remove()" />
			</div>
		)
	}
	<div class="article-wrap article-body" {...post.edit.content}>
		<PortableText value={content} components={{ type: { image: PostImage } }} />
	</div>
	<div class="article-wrap article-foot">
		<a href="/media" class="btn btn-outline">Media</a>
	</div>
</article>
