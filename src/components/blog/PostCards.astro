---
// Article cards in the design's editorial style, from CMS posts.
import { imageUrl } from "../../utils/media";

interface Props {
	posts: any[];
	/** Tag shown on every card (the category name). */
	tag?: string;
}

const { posts, tag } = Astro.props;
---

{
	posts.map((post) => {
		const img = imageUrl(post.data.featured_image);
		const label = tag ?? post.data.terms?.category?.[0]?.label;
		return (
			<a class="mcard" href={`/${post.id}`}>
				<span class="mimg">
					{img && <img src={img} alt={post.data.featured_image?.alt || post.data.title} loading="lazy" decoding="async" onerror="this.remove()" />}
				</span>
				<span class="mbody">
					{label && <span class="mtag">{label}</span>}
					<span class="mhead">{post.data.title}</span>
					<span class="mmore">
						Read more
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
					</span>
				</span>
			</a>
		);
	})
}
