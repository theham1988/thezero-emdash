---
/**
 * Full listing of one media category (/media/news, /media/blogs), or the
 * static press list (/media/press), in the Media page's design.
 */
import { getEmDashCollection } from "emdash";
import intros from "../../design/media-intros.json";
import pressCards from "../../design/press-cards.html?raw";
import Site from "../../layouts/Site.astro";
import PostCards from "./PostCards.astro";

interface Props {
	kind: "news" | "blogs" | "press";
}

const { kind } = Astro.props;
const META = {
	news: { title: "News", category: "news", tag: "News" },
	blogs: { title: "Blogs", category: "blog", tag: "Blog" },
	press: { title: "Press", category: null, tag: undefined },
} as const;
const meta = META[kind];

let posts: any[] = [];
if (meta.category) {
	const { entries, cacheHint } = await (getEmDashCollection as any)("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: 100,
		where: { category: meta.category },
	});
	if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
	posts = entries;
}
const tabs = [
	{ label: "News", href: "/media/news", kind: "news" },
	{ label: "Blogs", href: "/media/blogs", kind: "blogs" },
	{ label: "Press", href: "/media/press", kind: "press" },
];
---

<Site title={meta.title} description={intros[kind]} canonical={`${Astro.url.origin}/media/${kind}`} active="/media">
	<section class="page-hero" id="top">
		<div class="wrap">
			<span class="eyebrow">Media</span>
			<h1>{meta.title}</h1>
		</div>
	</section>
	<section class="media" id="media">
		<div class="wrap">
			<nav class="mtabs" aria-label="Media">
				{tabs.map((tab) => (
					<a class:list={["mtab", { on: tab.kind === kind }]} href={tab.href} aria-current={tab.kind === kind ? "page" : undefined}>
						{tab.label}
					</a>
				))}
			</nav>
			<p class="mintro">{intros[kind]}</p>
			<div class="mgrid">
				{kind === "press" ? <Fragment set:html={pressCards} /> : <PostCards posts={posts} tag={meta.tag} />}
			</div>
		</div>
	</section>
</Site>
