---
import { getEmDashCollection } from "emdash";
import Site from "../../layouts/Site.astro";
import { imageUrl } from "../../utils/media";

interface Props {
	title: string;
	/** Category slug to filter by. Omit to list everything. */
	category?: string;
	path: string;
}

const { title, category, path } = Astro.props;
const { entries, cacheHint } = await (getEmDashCollection as any)("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 100,
	...(category ? { where: { category } } : {}),
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const posts = entries as any[];

const tabs = [
	{ label: "All", href: "/media" },
	{ label: "News", href: "/media/news", slug: "news" },
	{ label: "Blogs", href: "/media/blogs", slug: "blog" },
];
const LABELS: Record<string, string> = { news: "News", blog: "Blog" };
const tagFor = (post: any): string | undefined =>
	category ? LABELS[category] : (post.data.terms?.category?.[0]?.label ?? undefined);
const banner = "/wp-content/uploads/2025/08/ZEBT_Perspective01-scaled-1-1.jpg";
---

<Site title={title} canonical={`${Astro.url.origin}${path}`} overHero active="/media">
	<section class="page-hero" style={`--page-hero-image:url(${banner})`}>
		<div class="wrap">
			<h1>{title}</h1>
		</div>
	</section>
	<section class="media">
		<div class="wrap">
			<nav class="mtabs" aria-label="Categories">
				{tabs.map((tab) => (
					<a href={tab.href} class:list={["mtab", { on: tab.href === path }]} aria-current={tab.href === path ? "page" : undefined}>
						{tab.label}
					</a>
				))}
			</nav>
			<div class="mgrid">
				{posts.map((post) => {
					const img = imageUrl(post.data.featured_image);
					const tag = tagFor(post);
					return (
						<a class="mcard" href={`/${post.id}`}>
							<span class="mimg">
								{img && <img src={img} alt={post.data.featured_image?.alt ?? ""} loading="lazy" decoding="async" onerror="this.remove()" />}
							</span>
							<span class="mbody">
								{tag && <span class="mtag">{tag}</span>}
								<span class="mhead">{post.data.title}</span>
								<span class="mmore">
									Read more
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
								</span>
							</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>
</Site>
