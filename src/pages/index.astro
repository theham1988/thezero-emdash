---
/**
 * Home page: the approved design, section for section. The markup lives in
 * src/design/home.main.html; edit copy there.
 */
import formScript from "../design/home.form.js?raw";
import headerHtml from "../design/home.header.html?raw";
import mainHtml from "../design/home.main.html?raw";
import homeScript from "../design/home.script.js?raw";
import Site from "../layouts/Site.astro";

const description =
	"Award-winning, EIA-approved sustainable condominiums in Bang Tao and Nai Yang, Phuket. Projected ~11% annual returns, 70/30 rental pool, freehold & leasehold. From THB 4.3M.";
---

<Site description={description} canonical={`${Astro.url.origin}/`} headerHtml={headerHtml} pageScript={homeScript + formScript} recaptcha>
	<Fragment set:html={mainHtml} />
</Site>
